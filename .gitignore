*.swo
*~

# OS clutter.
.DS_Store
Thumbs.db

# AI assistant configuration and local developer notes. Not part of the plugin.
.claude
CLAUDE.md

# Generated by admin/tool/phpunit/cli/util.php --buildcomponentconfigs.
# Contains paths and a PHPUnit schema version specific to one Moodle install.
phpunit.xml

# Tool caches and reports.
.phpunit.result.cache
.phpunit.cache
.phpcs-cache
.php-cs-fixer.cache
.phpdoc
clover.xml
coverage.xml
/coverage

# Dependencies. This plugin has no composer.json of its own; PHPUnit and the
# rest come from the surrounding Moodle installation. Anything here is a local
# experiment.
/vendor
/node_modules
composer.lock

# moodle-plugin-ci installs itself here when reproducing CI locally.
/ci
/moodle

# Packaged releases.
*.zip
*.tar.gz
